# StackOwl — annotated example configuration
#
# GENERATED by scripts/gen_config_example.py from the Settings model. Do not edit
# by hand: a test regenerates this file and fails if it differs, which is what
# keeps it from becoming a second, stale copy of the configuration surface.
#
# Every value shown is the DEFAULT. Delete what you do not want to change —
# an absent key uses the default, and this whole file is optional.
#
# Comments are each field's own description. Where a field has none, none is
# invented, so the gaps here are the gaps in the model's documentation.
#
# Secrets do NOT belong in this file. Store a REFERENCE instead:
#   some_api_key: "keychain:stackowl-anthropic"   # OS keychain (preferred)
#   some_api_key: "file:/run/secrets/anthropic"   # a file, whitespace stripped
#   some_api_key: "ANTHROPIC_API_KEY"             # an environment variable name
# See src/stackowl/config/secret_resolver.py.
#
# Environment variables are for bootstrap, host-specific and terminal-convention
# settings only — see tests/test_a_new_env_var_has_to_justify_itself.py for the
# taxonomy. Everything behavioural belongs here.

providers: []
test_mode: false
settings_watch: true
answer_floor_by_intent: true
judge_tier: standard
acceptance_tier: ''
acceptance_authority: true
reachability_enforcement: block
provider_retry_same_tier_once: true
unify_objective_recovery: true
unify_scheduler_recovery: true
unify_gateway_recovery: true
reversibility_resolver: true
trustworthy_learning: true
health_loop: true
decision_ledger: true
runtime:
  # Run the gateway and core as two processes over a local socket instead of one in-process monolith. ON by default — the durable gateway holds the TUI while the core can be restarted on code change. Set false to force the single-process compat path.
  split_process: true
  # Override path for the gateway<->core unix-domain socket. None = derive from the StackOwl home run dir.
  socket_path: null
  auto_restart:
    # Master switch for auto-restarting the core process when watched source files change. ON by default (dev hot-reload). Only takes effect when runtime.split_process is also true. Set false to disable code-change restarts.
    enabled: true
    # Settle / quiet-period before a detected code change triggers a restart: the restart fires only after this many minutes with NO further change (debounce). A burst of edits coalesces into one restart. 0 = restart as soon as the change settles for one poll.
    delay_minutes: 5.0
    # Repo-relative paths whose *.py mtimes are polled for changes. Defaults to the source tree.
    watch_paths: [src]
    # Only restart while a client (TUI/channel) is connected to the gateway. Avoids churn when nothing is attached to observe it.
    require_client_connected: true
    # Max seconds to wait for an in-flight turn to finish before forcing the restart. Stragglers are durable-checkpointed or terminally stopped at the ceiling.
    grace_seconds: 120.0
    # How often (seconds) the code watcher polls watched mtimes.
    poll_interval_s: 2.0


budget:
  # Daily spend cap in USD. None = unlimited.
  daily_limit_usd: null
  # Conservative price (USD per 1M tokens, applied to both input and output) charged for an unrecognized CLOUD model absent from pricing.yaml. Deliberately high so an unpriced paid model trips the budget cap rather than silently billing $0 (F128). Local/self-hosted backends are always free; this only affects unknown cloud models.
  unknown_cloud_per_1m_usd: 15.0
  # Soft per-turn budget in USD. When a single interactive turn's accumulated LLM spend crosses this, the assistant ASKS the user (Continue / Stop) before any further expensive op (delegation / mixture-of-agents) runs. This is a SOFT pause (asks, never raises) and is distinct from daily_limit_usd (a hard cap). Interactive-only: background runs (cron/heartbeat/parliament/delegation children) are never paused. None = the per-turn pause is disabled.
  per_turn_pause_usd: 0.5

orchestrator:
  # Pipeline orchestration backend. 'asyncio' is the default known-good backend; 'langgraph' is experimental/opt-in (the LangGraph backend exists but is exercised only when explicitly selected).
  backend: asyncio
  # Maximum number of tools presented to the model per turn. The discretionary roster is relevance-ranked and clipped to this count; guaranteed base tools are always included and count toward it. Default 40 matches the historical cap (byte-identical). Lower it (e.g. 12-18) for weak/quantized models that derail when offered too many tools.
  tool_count_cap: 40

durable:
  # Route scheduled owl goals AND objective sub-goals through the durable pipeline (checkpointed, exactly-once, resumable) so long-running autonomous work survives a restart. ON by default as of the Objective Manager keystone; set False to fall back to the legacy ephemeral path.
  goals: true

parliament:
  # Maximum debate rounds per Parliament session.
  max_rounds: 3
  # Hard wall-clock timeout for a full Parliament session.
  session_timeout_s: 90.0
  # Per-owl timeout for a single round.
  per_owl_timeout_s: 30.0
  # Cumulative output-character budget per owl before truncation.
  token_budget: 20000
  # Mean pairwise cosine-similarity threshold for early termination.
  convergence_threshold: 0.85

memory:
  enabled: true
  semantic_search_enabled: true
  provider_schema_ceiling: 6
  sensitive_categories: [password, ssn, credit_card, api_key, private_key]
  promotion_confidence_threshold: 0.8
  reinforcement_required: 3
  conversation_fact_reinforcement_required: 0
  conversation_fact_dedup_similarity: 0.92
  prune_after_days: 90
  extraction_after_n_messages: 5
  per_user_ceiling_bytes: 52428800
  short_term_window: 6
  contradiction_ann_k: 32
  contradiction_ann_threshold: 200
  recall_limit: 5
  recall_candidate_pool: 20
  recall_decay_half_life_days: 30.0

scheduler:
  # Maximum number of jobs allowed to run concurrently.
  max_concurrent_jobs: 3
  # How many hours back to replay missed jobs on recovery.
  replay_window_hours: 24

brief:
  # Default delivery cadence for the morning brief job.
  schedule: daily@08:00
  # Channel identifiers that should receive the rendered brief.
  channels: [telegram]
  # Per-section toggle map keyed by assembler key.
  sections: {agent_status: true, date_and_priorities: true}

check_in:
  # Whether the proactive check-in job is scheduled. ON by default so the promised periodic outreach fires; the seed still only creates a row when a single resolvable recipient exists (never a dead no-op row).
  enabled: true
  # Delivery cadence for the check-in job, as daily@HH:MM (24h).
  schedule: daily@18:00
  # Channel identifiers that should receive the check-in.
  channels: [telegram]

session:
  # Which automatic boundaries are armed: none | idle | daily | both.
  reset_mode: both
  # Local hour of the daily conversation boundary (0-23).
  at_hour: 4
  # Silence after which a conversation is considered ended. Default 24h.
  idle_minutes: 1440
  # Show a one-line notice when a conversation rolled over. A boundary the user cannot see is one they experience as amnesia.
  notify_on_reset: true
  # Isolate group/channel conversations per speaker.
  group_sessions_per_user: true
  # Threads are SHARED by default — a thread is a focused sub-discussion where shared context is the point.
  thread_sessions_per_user: false
  # Consecutive restarts failing to complete a turn on ONE lane before it is wiped. Per-lane, so one poisoned conversation cannot take the others down with it.
  max_restart_failures: 3

system:
  # IANA timezone identifier used for user-facing timestamps.
  timezone: UTC
  # Hard wall-clock deadline (seconds) for ONE interactive turn (state.interactive=True). On expiry the turn's step loop is cancelled and an honest floor message is delivered instead of the turn hanging forever. 0 disables. Non-interactive runs (scheduler, parliament, delegation children, evolution) are never affected — they carry their own budgets.
  interactive_turn_timeout_s: 600.0

ui:
  # UI language; 'auto' selects from environment locale.
  language: auto
  # Active TUI implementation; 'v1' for legacy fallback.
  tui_version: v2
  # Suppress motion/animation in TUI for accessibility.
  reduced_motion: false
  # Show a fenced '☆ suggested' lane of learned next-likely commands in the TUI dropdown's low-commitment window (just '/' typed). Suggest-only; never reorders the deterministic rows, never fires. ON by default; set False for a dropdown byte-identical to the deterministic baseline.
  command_suggestions: true
  # Gait-read the compose box: a natural-language phrase that matches no command path switches the panel to resolver-ranked command candidates (marked ☆), and a forward ghost-text predicts the next token. Selecting a candidate only POPULATES the box — never fires. ON by default; set False for the byte-identical deterministic dropdown.
  semantic_command_search: true
  # When a natural-language turn strongly matches a slash command, append a marked, non-intrusive command hint to the owl's reply (all channels). The owl still answers normally; the hint never auto-runs. ON by default; set False to suppress the hints.
  command_hints: true

progress:
  # Master switch for live turn-progress UX (typing indicator + a mutating status line on Telegram, and the animated PipelineStrip in the terminal). ON by default — fixes the 'silent void' problem. Set false to restore the all-at-once baseline.
  live_progress: true
  # Minimum seconds between Telegram status-message edits. Coalesces rapid state changes (keeps the latest) to stay under Telegram's ~1 edit/sec rate limit.
  telegram_edit_min_interval_s: 1.0
  # Seconds between re-issuing the Telegram 'typing' chat action (Telegram clears it after ~5s, so it must be refreshed).
  typing_reissue_interval_s: 4.0
  # Suppress any progress status for the first N milliseconds of a turn so fast turns (<400ms) never flash a status that instantly vanishes.
  flicker_guard_ms: 400.0
  # How often the background liveness ticker wakes to refresh the Telegram status during a long model 'think' with no ReAct events — re-issues typing and updates the elapsed counter so the chat never looks dead.
  tick_interval_s: 3.0
  # Only append an elapsed counter ('Working on it… (12s)') once the turn has run this many seconds — a ticking counter on a short turn is noise.
  elapsed_after_s: 10.0
  # After this many seconds, a still-generic status ('Working on it…') switches to a reassurance phrase ('Still working on this…').
  reassure_after_s: 30.0

notifications:
  # Channel used when a notification omits ``channel_name``.
  default_channel: cli
  # ADR-2 — when transport to the target channel FAILS (after the in-channel retry), the RecoveryActuator reroutes the message to THIS channel before surrendering. Empty (the default) ⇒ no reroute (byte-identical: a failed transport stays 'failed'). Set to a registered channel name to opt in. A reroute to the same channel that just failed is skipped.
  fallback_channel: ''
  quiet_hours:
    # Master toggle for quiet hours.
    enabled: false
    # Local-time HH:MM at which quiet hours begin.
    start: '22:00'
    # Local-time HH:MM at which quiet hours end.
    end: 08:00
    # IANA timezone used to evaluate the start/end window.
    timezone: UTC

  # Per-category opt-in map keyed by category name.
  subscriptions: {}
  # Rate-limit cap enforced by the notification router.
  max_notifications_per_hour: 10

task_loop:
  # Master switch for the durable task loop. Off means nothing claims pending tasks — rows still accumulate, so turning it back on resumes rather than loses work.
  enabled: true
  # How often the loop looks for claimable work. Bakir asked for five seconds. This is the SAFETY NET rather than the only trigger: an enqueue can wake the loop immediately, and the tick is what catches expired leases, backed-off retries and anything a missed signal dropped.
  tick_seconds: 5.0
  # How many tasks run CONCURRENTLY. Bakir: 'if in table we have five pending, five loops parallel... there is no ordering.' A ceiling rather than a promise — it bounds how much of this box a runaway backlog can take.
  max_parallel: 5
  # Attempts before a task dead-letters, when its row does not say otherwise. Bakir's thirty. Per-task rows may override it, so a cheap certainty and an expensive maybe are not forced to share a budget.
  default_max_attempts: 30
  # How long a claim is good for. Long enough that a slow but live task is not stolen mid-flight; short enough that a crashed worker's row returns quickly. Exceeding it counts an attempt, so a task that reliably kills its worker still reaches the ceiling.
  lease_seconds: 900
  # Bakir: 'delete completed jobs older than one day.' DELIVERED rows only — a dead_letter is never pruned, because it is the one record of work that failed for good and is precisely what an operator needs to see. The learning corpus lives in task_outcomes and is untouched.
  prune_completed_after_days: 1
  # Failure classes that stop a task IMMEDIATELY instead of spending its whole attempt budget. A missing API key fails identically every time, so thirty attempts is thirty guaranteed-wasted model calls — seconds of latency each on this hardware. Configurable because which failures are truly permanent is deployment-specific: what is unrecoverable behind one gateway may be a transient blip behind another.
  permanent_failure_classes: [permanent, auth, not_found, refused]
  # The LOOP produces the chat reply, not merely recovers one — Bakir's design in full: 'the loop should go understand, find the answer, return back answer to the Telegram.'
  # 
  # TURNED BACK OFF 2026-08-18 after Bakir used it, and the reason is worth keeping: loop production WORKS (measured — claim to delivered in 9s and 23s on real turns), but it loses the instant acknowledgement that the fast path sends and then REPLACES IN PLACE with the real answer. On a platform where a turn takes 9-30s, that ack is what tells the user their message was received at all; without it the wait reads as nothing happening.
  # 
  # This goes back ON once the loop path sends its own ack and edits it in place — RetryActuator._deliver_success ALREADY edits a message when it has a channel_message_id, so the missing piece is creating one, not new delivery machinery. Until then the fast path produces and the loop owns recovery; the durable row, the delivery rule and the retry ladder are identical either way.
  produce_replies: false
  # Tell the operator when a task stops for good. ON by default because a loop that abandons work silently is worse than one that fails loudly — the whole point of a durable queue is that nothing vanishes unnoticed.
  escalate_dead_letters: true

owl_limits:
  # How many agent-created owls are allowed. 0 (the default) means UNLIMITED — Bakir's call, 2026-08-18, and the measurement supports it: the only real cost of another owl is the ground-truth roster in the system prompt (name + one-line role, every call), which runs 69 chars per owl on the live registry. Fifty owls would be ~862 tokens, 0.33% of a 262,144 window. The previous cap of five was not protecting the waist.
  # 
  # Kept as a setting rather than deleted so a shared deployment can still bound it without a code change. What actually prevents a mess is unchanged: owl_build still refuses a near-duplicate, enforces name quality, and requires consent for the tools a new owl is granted — guards that catch twenty variants of one persona, which a hard count never did (a count blocks the sixth GOOD owl as readily as the sixth junk one).
  max_agent_owls: 0

webhook:
  # Master toggle for the webhook HTTP receiver.
  enabled: false
  # IP the receiver binds to — defaults to loopback for safety.
  bind_address: 127.0.0.1
  # TCP port the receiver listens on.
  port: 8766
  # Per-source HMAC config keyed by url-path source name.
  sources: {}

discord_channel:
  bot_token: ''
  allowed_user_ids: []
  guild_id: null
  socket_mode: true
  suppress_evolution_events: false
  enabled: false

slack_channel:
  bot_token: ''
  signing_secret: ''
  allowed_user_ids: []
  socket_mode: true
  app_token: ''

telegram_channel:
  bot_token: ''
  allowed_user_ids: []
  webhook_url: null
  webhook_secret: ''
  socket_mode: false
  suppress_evolution_events: false
  quiet_hours:
    enabled: false
    start_hour: 22
    end_hour: 7
    timezone: UTC
    urgent_override: true


whatsapp_channel:
  allowed_phone_numbers: []
  session_dir: ''
  headless: true
  suppress_evolution_events: false
  page_load_timeout_ms: 30000
  enabled: false

mcp_client:
  servers: []
  tool_cache_ttl_seconds: 300.0
  allowed_uri_prefixes: ['stdio://', 'sse://http://localhost:']
  auto_discover_on_startup: true

mcp_server:
  enabled: false
  host: 127.0.0.1
  port: 8765
  transport: sse
  server_name: stackowl
  server_version: 2.0.0
  max_connections: 10
  capability_negotiation_timeout_ms: 500
  # When False (default), the MCP-exposed tool surface denies consequential browser tools (eval_js, upload, download, cookies_set/clear, storage_set, close, set_proxy, tab_close, click, type, scroll, and the browse meta-tool). Set True only when the MCP client is trusted.
  allow_browser_writes: false
  # When False (default), ANY consequential tool (e.g. send_message, skill_manage) is denied across the MCP boundary — the headless MCP server has no interactive consent channel, so a consequential tool would run ungated for an external client. Set True only when the MCP client is fully trusted to invoke consequential actions without consent.
  allow_consequential: false
  # FX-06 — shared-secret token required from SSE clients as 'Authorization: Bearer <token>'. The SSE transport binds to a real network host:port with no other gate (no interactive consent channel exists for an external client), so an unset token means ANY client that can reach the port has the exposed tool surface. None (default) leaves the transport unauthenticated for backward compatibility with existing configs — a loud warning is logged on start_sse either way. Sensitive: auto-redacted in logs by the *token key-pattern.
  auth_token: null

browser:
  headless_mode: virtual
  humanize: true
  block_images: true
  block_webrtc: true
  geoip: true
  cache_enabled: true
  disable_coop: true
  addons: []
  firefox_user_prefs: {}
  fingerprint_rotation: per_profile
  backend: local
  attach_url: ''
  nav_recycle_threshold: 200
  idle_recycle_minutes: 30
  session_idle_timeout_minutes: 30
  max_concurrent_sessions: 8
  max_concurrent_pages_per_session: 4
  dialog_auto_dismiss_seconds: 60.0
  screenshots_dir: ~/.stackowl/screenshots
  profiles_dir: ~/.stackowl/browser-profiles
  downloads_dir: ~/.stackowl/workspace/downloads
  browser_cache_dir: ~/.stackowl/cache/browser
  default_proxy: null
  enable_screenshot_captions: false
  inner_browse_max_steps: 20
  inner_browse_model_tier: standard
  per_domain_rate_limit_seconds: 2.0
  enable_har_recording: false

owls: []
retired_builtin_owls: []
# Tool autonomy level for owls.
autonomy_level: medium
governance:
  # Number of days to keep audit_log rows before pruning.
  audit_retention_days: 90
  # HMAC-SHA256 key used to sign audit log exports. Empty = unsigned.
  audit_export_key: ''
  # Auto-merge Dependabot security PRs on the same day they open.
  same_day_security_prs: true

web_search:
  # Base URL of a self-hosted SearXNG instance (e.g. 'http://localhost:8080'). Empty disables the SearXNG provider. Network-free availability check.
  searxng_base_url: ''
  # Secret REFERENCE for the Brave Search API key — an env-var name, 'keychain:<service>', or 'file:<path>' (resolved at use, never the raw secret). Empty disables the Brave provider. Network-free availability check.
  brave_api_key: ''

tts:
  # TTS engine selection. 'piper' = local OSS engine only. 'auto' = local first, then the cloud fallback IF it is enabled + configured.
  engine: piper
  # Default local-engine voice id (overridable per call).
  voice: en_US-lessac-medium
  # Override host for downloading local voice models (air-gapped / self-hosted mirror). Empty = the engine's published voice host.
  voice_base_url: ''
  # Opt-in switch for the cloud TTS fallback. False (default) = local engine only; the text never leaves the machine.
  cloud_enabled: false
  # Secret REFERENCE for the cloud TTS endpoint key — an env-var name, 'keychain:<service>', or 'file:<path>' (resolved at use, never the raw secret). Empty disables the cloud fallback regardless of cloud_enabled.
  cloud_api_key: ''
  # Base URL of the OpenAI-compatible speech endpoint for the cloud fallback. Point this at a self-hosted endpoint to keep audio on-prem.
  cloud_base_url: https://api.openai.com/v1
  # Default voice id for the cloud fallback.
  cloud_voice: alloy
  # Model id sent to the cloud speech endpoint.
  cloud_model: tts-1

transcription:
  # Master switch for voice transcription (Telegram voice notes + TUI push-to-talk). ON by default: Telegram voice notes are transcribed (local Whisper) and shown with a Send/Discard prompt, and the TUI Ctrl+R push-to-talk dictates into the compose box. Set False to wire neither path (byte-identical to a build without this feature).
  enabled: true
  # STT engine selection. 'local' = local Whisper only (audio never leaves the box). 'auto' = local first, then a cloud fallback IF one is enabled + configured (no cloud STT backend ships yet).
  engine: local
  # Local Whisper model size ('tiny', 'base', 'small', 'medium', 'large'). Smaller = faster but less accurate; consider 'tiny' on a CPU-only / ARM host where 'base' is slow.
  model: base
  # Optional ISO language hint for the local engine (e.g. 'en'). Empty = let Whisper auto-detect the spoken language (multilingual).
  language: ''
  # Opt-in switch for a future cloud STT fallback. False (default) = local engine only; the audio never leaves the machine. (Placeholder: no cloud STT backend ships yet.)
  cloud_enabled: false
  # Secret REFERENCE for a future cloud STT endpoint key — an env-var name, 'keychain:<service>', or 'file:<path>' (resolved at use, never the raw secret). Empty disables the cloud fallback. (Placeholder.)
  cloud_api_key: ''

image:
  # Image engine selection. 'auto' = probe → local SDXL if viable, else the cloud fallback IF enabled + configured. 'local' = local-only (never cloud). 'cloud' = cloud-only (skip the local probe).
  engine: auto
  # Local OSS image model id (used only where the probe clears).
  model: stabilityai/sdxl-turbo
  # Default output size 'WIDTHxHEIGHT' (overridable per call).
  size: 1024x1024
  # Opt-in switch for the cloud image fallback. False (default) = local only; the prompt never leaves the machine.
  cloud_enabled: false
  # Secret REFERENCE for the cloud image endpoint key — an env-var name, 'keychain:<service>', or 'file:<path>' (resolved at use, never the raw secret). Empty disables the cloud fallback regardless of cloud_enabled.
  cloud_api_key: ''
  # Base URL of the OpenAI-compatible image endpoint for the cloud fallback. Point this at a self-hosted endpoint to keep prompts on-prem.
  cloud_base_url: https://api.openai.com/v1
  # Model id sent to the cloud image endpoint.
  cloud_model: dall-e-3

sandbox:
  # Allow the Docker sandbox backend (the network-capable tier). False = bwrap-only; network-requiring code runs then refuse with a clear reason. Docker here is ROOTFUL, so disable this for the tightest blast radius.
  docker_enabled: true
  # Allow the rootless bubblewrap sandbox backend (the primary). False = Docker-only; if both are false, code execution is unavailable.
  bwrap_enabled: true

clarify:
  # Fallback seconds to await a human Raise/Stop before failing closed.
  wait_timeout_s: 600.0
  # Per-channel clarify wait-timeout overrides (channel name → seconds).
  per_channel: {}

identity:
  # Map of identity_key → list of channel handles. Example: {"owner-primary": ["telegram:123", "slack:U9"]}
  aliases: {}

skills:
  # When True, every tool-using turn surfaces a CATALOG of installed skills (names only) in the system prompt so an owl that does not own a skill still knows it exists and can skill_view it. The default Secretary owns no skills, so without this it never learns skills exist. Set False to restore the byte-identical pre-feature baseline.
  global_catalog: true
